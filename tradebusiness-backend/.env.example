# ==================== Application ====================
APP_NAME=TradeBusiness API
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ==================== Server ====================
HOST=0.0.0.0
PORT=8000

# ==================== Database (MySQL 8.0) ====================
# MySQL数据库连接字符串
# 格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/tradebusiness?charset=utf8mb4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==================== Redis ====================
# Redis连接（可选，用于缓存和任务队列）
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# ==================== Security ====================
# 密钥（生产环境请修改为随机字符串）
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS ====================
# 允许的跨域来源
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ==================== Email Configuration ====================
# SMTP配置（邮件发送功能）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=TradeBusiness

# 或使用阿里云邮件
# SMTP_HOST=smtp.aliyun.com
# SMTP_PORT=465
# SMTP_USER=your-email@aliyun.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your-email@aliyun.com
# SMTP_FROM_NAME=TradeBusiness

# ==================== Celery ====================
# Celery任务队列配置
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ==================== File Storage ====================
# 文件上传目录
UPLOAD_DIR=./uploads

# MinIO对象存储（可选，生产环境推荐）
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=tradebusiness

# ==================== Scraping Configuration (新增) ====================
# 爬虫配置
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_TIMEOUT=30
SCRAPER_MAX_CONCURRENT=10
SCRAPER_DELAY_MIN=1
SCRAPER_DELAY_MAX=3

# 代理列表（可选，逗号分隔）
# SCRAPER_PROXIES=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080

# ==================== WebSocket Configuration (新增) ====================
# WebSocket心跳间隔（秒）
WS_HEARTBEAT_INTERVAL=30

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ==================== Rate Limiting ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ==================== Pagination ====================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ==================== API Keys (可选) ====================
# Google API
# GOOGLE_API_KEY=your-google-api-key

# LinkedIn API
# LINKEDIN_API_KEY=your-linkedin-api-key

# Clearbit API
# CLEARBIT_API_KEY=your-clearbit-api-key
