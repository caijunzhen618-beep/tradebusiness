# Production example. Copy to a secure env store or .env.production and replace every value.
ENVIRONMENT=production
DEBUG=false

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=tradebusiness
MYSQL_USER=tradebusiness
MYSQL_PASSWORD=replace-with-strong-db-password

SECRET_KEY=replace-with-at-least-32-random-characters
JWT_SECRET_KEY=replace-with-another-32-random-characters
JWT_ALGORITHM=HS256

# Comma-separated frontend origins. Do not include localhost in production.
CORS_ORIGINS=https://admin.example.com,https://client.example.com
# 生产环境部署到 IP 时，填写实际前端源，例如：
# CORS_ORIGINS=http://8.145.59.67:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=TradeBusiness

# Celery / Redis
REDIS_PASSWORD=replace-with-a-long-random-password
CELERY_CONCURRENCY=4
CELERY_BROKER_URL=redis://:replace-with-a-long-random-password@redis:6379/2
CELERY_RESULT_BACKEND=redis://:replace-with-a-long-random-password@redis:6379/3

# Stripe Checkout and Webhook
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=https://admin.example.com/settings/plans?success=1
STRIPE_CANCEL_URL=https://admin.example.com/settings/plans?cancelled=1
STRIPE_CURRENCY=usd

# AI Provider（未配置时使用本地规则回退）
AI_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
